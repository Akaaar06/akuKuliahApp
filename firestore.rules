rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isValidId(courseId)
        && incoming().nama is string && incoming().nama.size() <= 200
        && incoming().kode is string && incoming().kode.size() <= 32
        && incoming().dosenPengampu is string && incoming().dosenPengampu.size() <= 200;
      allow update: if isValidId(courseId)
        && incoming().nama is string && incoming().nama.size() <= 200;
      allow delete: if isValidId(courseId);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isValidId(taskId)
        && incoming().namaTugas is string && incoming().namaTugas.size() <= 255
        && incoming().mataKuliahId is string && incoming().mataKuliahId.size() <= 128
        && incoming().deadline is string;
      allow update: if isValidId(taskId)
        && incoming().namaTugas is string && incoming().namaTugas.size() <= 255;
      allow delete: if isValidId(taskId);
    }

    // Materials collection
    match /materials/{materialId} {
      allow read: if true;
      allow create: if isValidId(materialId)
        && incoming().nama is string && incoming().nama.size() <= 255
        && incoming().courseId is string && incoming().courseId.size() <= 128
        && incoming().format is string && incoming().format in ['PDF', 'PPT', 'PPTX']
        && incoming().lokasiPenyimpanan is string;
      allow update: if isValidId(materialId);
      allow delete: if isValidId(materialId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
